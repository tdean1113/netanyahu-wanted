# Server
PORT=8080
ADMIN_PASSWORD=changeme
ADMIN_TOKEN_SECRET=replace-with-long-random-string
CORS_ORIGINS=http://localhost:5173,https://netanyahuwanted.com,https://www.netanyahuwanted.com
FRONTEND_BASE_URL=http://localhost:5173

# Set MOCK_SQUARE=1 (or leave SQUARE_ACCESS_TOKEN empty) for local UI testing
MOCK_SQUARE=1

# Square AU
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# From npm run setup:catalog
SQUARE_MEDAL_VARIATION_ID=
SQUARE_DONATION_APAN_VARIATION_ID=
SQUARE_DONATION_ACIJ_VARIATION_ID=
SQUARE_DONATION_OLIVE_KIDS_VARIATION_ID=
SQUARE_DONATION_PARA_VARIATION_ID=
SQUARE_DONATION_PANZMA_VARIATION_ID=

# Shown on Square checkout confirmation / receipt for buyer support contact
MERCHANT_SUPPORT_EMAIL=info@netanyahuwanted.com
MERCHANT_NAME=Medal Art Mint

# Buyer confirmation email (contact details + delivery address).
# Use either Resend OR SMTP (e.g. Gmail App Password).
RESEND_API_KEY=
# EMAIL_FROM=Medal Art Mint <netanyahuwanted@gmail.com>
# EMAIL_BCC=netanyahuwanted@gmail.com,tdean1113@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tdean1113@gmail.com
# SMTP_PASS=

# Square webhook (Developer Console → Webhooks). Required to auto-email after payment.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://mam-medal-api-151658014953.australia-southeast1.run.app/api/webhooks/square

