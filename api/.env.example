# Server
PORT=8080
ADMIN_PASSWORD=changeme
ADMIN_TOKEN_SECRET=replace-with-long-random-string
CORS_ORIGINS=http://localhost:5173,https://netanyahuwanted.com,https://www.netanyahuwanted.com
FRONTEND_BASE_URL=http://localhost:5173

# Set MOCK_SQUARE=1 (or leave SQUARE_ACCESS_TOKEN empty) for local UI testing
MOCK_SQUARE=1

# Square AU
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# From npm run setup:catalog
